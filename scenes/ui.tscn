[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui.gd" id="1_ui"]
[ext_resource type="Script" path="res://scripts/combat/combat_hud.gd" id="2_hud"]

[node name="UI" type="CanvasLayer" node_paths=PackedStringArray("weather_button", "time_button", "view_button", "drift_button", "sound_button", "bar", "mark", "hint", "title", "cast_button", "combat_hud")]
script = ExtResource("1_ui")
weather_button = NodePath("Bar/Weather")
time_button = NodePath("Bar/Time")
view_button = NodePath("Bar/View")
drift_button = NodePath("Bar/Drift")
sound_button = NodePath("Bar/Sound")
bar = NodePath("Bar")
mark = NodePath("Mark")
hint = NodePath("Hint")
title = NodePath("Title")
cast_button = NodePath("Title/Card/CastRow/Cast")
combat_hud = NodePath("CombatHUD")

[node name="CombatHUD" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
